+        <ol className="grid gap-px overflow-hidden bg-black/10 sm:grid-cols-2 lg:grid-cols-4">
+          {steps.map((step) => (
+            <li key={step.number} className="bg-[#f4f0eb] p-7 md:p-8">
+              <span className="text-xs font-medium tracking-[0.12em] text-[#805533]">
