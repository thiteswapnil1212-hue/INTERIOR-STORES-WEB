diff --git a/src/components/seo/BreadcrumbJsonLd.tsx b/src/components/seo/BreadcrumbJsonLd.tsx
new file mode 100644
index 0000000..4e70dc7
--- /dev/null
+++ b/src/components/seo/BreadcrumbJsonLd.tsx
@@ -0,0 +1,33 @@
+import type { ReactNode } from "react";
+
+const siteUrl = "https://mauliinterior-stores-web.vercel.app";
+
+type Crumb = {
+  name: string;
+  path: string;
+};
+
+/**
+ * Renders BreadcrumbList structured data so search engines
+ * understand the page's position in the site hierarchy.
+ * No visible output — purely for SEO.
+ */
+export default function BreadcrumbJsonLd({ items }: { items: Crumb[] }): ReactNode {
+  const data = {
+    "@context": "https://schema.org",
+    "@type": "BreadcrumbList",
+    itemListElement: items.map((item, index) => ({
+      "@type": "ListItem",
+      position: index + 1,
+      name: item.name,
+      item: `${siteUrl}${item.path}`,
+    })),
+  };
+
+  return (
+    <script
+      type="application/ld+json"
+      dangerouslySetInnerHTML={{ __html: JSON.stringify(data) }}
+    />
+  );
+}
