+            >
+              <blockquote className="flex-1 text-sm leading-7 text-[#444748]">
+                &ldquo;{testimonial.quote}&rdquo;
+              </blockquote>
+
+              <figcaption className="mt-6 border-t border-[#747878]/15 pt-4">
