From 27c91c565c97e247e64f788d4600a74fee2429a7 Mon Sep 17 00:00:00 2001
From: Muse <muse@local>
Date: Tue, 29 Sep 2026 04:37:50 +0000
Subject: [PATCH] Rewrite homepage copy in direct human voice, add premium
 motion touches
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Replace AI-fluff marketing lines with short, direct copy (hero, services,
  discovery, featured work, why-mauli, final CTA) — facts unchanged
- Hero image: slow cinematic zoom on page load
- Hover lift on discovery cards and WhyMauli reason cards
---
 src/app/globals.css                     | 22 +++++++++++++++++++
 src/app/page.tsx                        | 28 ++++++++++++-------------
 src/components/home/FeaturedWork.tsx    |  8 +++----
 src/components/home/FinalCTA.tsx        |  4 ++--
 src/components/home/ServicesSection.tsx | 12 +++++------
 src/components/home/WhyMauli.tsx        | 14 ++++++-------
 6 files changed, 54 insertions(+), 34 deletions(-)

diff --git a/src/app/globals.css b/src/app/globals.css
index 36da59f..2c785df 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -457,3 +457,25 @@ summary {
     animation: none;
   }
 }
+
+@keyframes hero-zoom {
+  from {
+    transform: scale(1.07);
+  }
+  to {
+    transform: scale(1);
+  }
+}
+
+@layer components {
+  /* Slow cinematic zoom on the hero image at page load */
+  .animate-hero-zoom {
+    animation: hero-zoom 2.4s cubic-bezier(0.22, 1, 0.36, 1);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .animate-hero-zoom {
+    animation: none;
+  }
+}
